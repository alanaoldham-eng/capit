# --- Network -------------------------------------------------------------
# Which Base network the UI targets: "sepolia" or "mainnet".
# Keep this on "sepolia" until the CAPIT token and Uniswap LP are actually
# deployed to Base mainnet - otherwise the On-Chain Verification card links to
# a contract that does not exist. Flip all three of the vars in this block
# together as part of the mainnet deploy.
NEXT_PUBLIC_BASE_NETWORK=sepolia
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org
NEXT_PUBLIC_CAPIT_TOKEN_ADDRESS=

# --- WalletConnect / Web3Modal -------------------------------------------
# REQUIRED. Project ID from https://cloud.walletconnect.com (32 hex chars).
# Without it, WalletConnect is disabled and only injected wallets (MetaMask
# extension) and Coinbase Wallet can connect.
# If you get 403s from api.web3modal.org even with this set, check the project's
# allowed-domains list in WalletConnect Cloud - localhost and your deploy domain
# both have to be listed.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- TinaCMS -------------------------------------------------------------
# REQUIRED for editing content through /admin on a deployed site.
# Both come from your project at https://app.tina.io
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Branch TinaCMS commits content edits to. Defaults to "main".
GITHUB_BRANCH=main
