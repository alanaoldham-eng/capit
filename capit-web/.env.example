# --- WalletConnect / Web3Modal -------------------------------------------
# REQUIRED for production. Create a project at https://cloud.walletconnect.com
# and paste its Project ID here. Without it, WalletConnect is disabled and only
# injected wallets (MetaMask extension) and Coinbase Wallet will connect.
# Do NOT reuse a wallet id from the WalletConnect explorer here - that returns 403.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Network -------------------------------------------------------------
# Leave unset (or "false") for production: the app runs on Base mainnet.
# Set to "true" in a preview environment to also offer Base Sepolia.
NEXT_PUBLIC_ENABLE_TESTNET=false

# --- TinaCMS -------------------------------------------------------------
# REQUIRED for editing content through /admin on a deployed site.
# Both come from your project at https://app.tina.io
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Branch TinaCMS commits content edits to. Defaults to "main".
GITHUB_BRANCH=main
